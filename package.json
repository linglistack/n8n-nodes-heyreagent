{
  "name": "n8n-nodes-heyreagent",
  "version": "0.1.3",
  "description": "n8n community node for HeyReagent: work with your own LinkedIn account (messages, invitations, search, posts). Not affiliated with LinkedIn.",
  "license": "MIT",
  "homepage": "https://heyreagent.com/n8n-linkedin",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "HeyReagent",
    "email": "hello@heyreagent.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linglistack/n8n-nodes-heyreagent.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "generate": "node scripts/generate.mjs && prettier --write nodes/HeyReagent/actions.ts"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HeyReagentApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/HeyReagent/HeyReagent.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
